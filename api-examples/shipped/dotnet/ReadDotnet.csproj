<Project Sdk="Microsoft.NET.Sdk">
  <!-- read_shipped.py sets ShippedPackage and ShippedVersion to the NuGet package to read. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="$(ShippedPackage)" Version="$(ShippedVersion)" />
  </ItemGroup>
</Project>
