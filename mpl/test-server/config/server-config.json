{
  "_comment": [
    "MPL TestServer commons server-config.json (design 'Server Configuration'):",
    "product + one Configuration_Entry per language. The Feature_Catalog lives in the",
    "sibling feature-set.json and the bug ledger in bug-list.json (the doc's",
    "three-file layout) — the only supported configuration format. The shared",
    "orchestrator (test-server-common/orchestrator/) loads this trio and resolves",
    "each entry's server from its Server_Location.",
    "",
    "The Rust Language_Server lives in aws-crypto-tools-rust under mpl-test-server/;",
    "the Java Language_Server lives in aws-cryptographic-material-providers-library",
    "under test-server/mpl/java-v1-server/ and runs against the published MPL on",
    "Maven Central, so its libraryRepository path is the server directory (no",
    "Dafny transpile). configPath names the DIRECTORY holding each server's",
    "per-server trio (server-config.json/feature-config.json/bug-config.json)."
  ],
  "product": "mpl",
  "entries": [
    {
      "language": "java",
      "majorVersion": 1,
      "port": 8101,
      "configPath": "test-server/mpl/java-v1-server",
      "libraryRepository": {
        "name": "aws-cryptographic-material-providers-library",
        "url": "git@github.com:aws/aws-cryptographic-material-providers-library.git",
        "branch": "jocorell/mpl-test-server-java",
        "path": "test-server/mpl/java-v1-server"
      },
      "serverLocation": {
        "repository": "aws-cryptographic-material-providers-library",
        "url": "git@github.com:aws/aws-cryptographic-material-providers-library.git",
        "ref": "jocorell/mpl-test-server-java",
        "path": "test-server/mpl/java-v1-server"
      }
    },
    {
      "language": "rust",
      "majorVersion": 1,
      "port": 8093,
      "configPath": "mpl-test-server",
      "libraryRepository": {
        "name": "aws-crypto-tools-rust",
        "url": "git@github.com:aws/aws-crypto-tools-rust.git",
        "branch": "aws-crypto-rust/mpl-test-server",
        "path": "mpl"
      },
      "serverLocation": {
        "repository": "aws-crypto-tools-rust",
        "url": "git@github.com:aws/aws-crypto-tools-rust.git",
        "ref": "aws-crypto-rust/mpl-test-server",
        "path": "mpl-test-server"
      }
    }
  ]
}
