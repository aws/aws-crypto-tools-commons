{
  "_comment": [
    "The MPL TestServer Configuration_Set: one product field, one",
    "Feature_Catalog, and one Configuration_Entry per language.",
    "",
    "Rust is the first language implementing the MPL TestServer.",
    "Its Feature_Declaration lives in its Language_Repository's",
    "commons-configuration.json (at mpl-test-server/)."
  ],
  "product": "mpl",
  "features": [
    "raw-aes",
    "default-cmm",
    "hierarchical",
    "caching-cmm",
    "required-encryption-context-cmm",
    "raw-rsa",
    "aws-kms",
    "multi-keyring",
    "storm-tracking-cmc"
  ],
  "entries": [
    {
      "language": "rust",
      "majorVersion": 1,
      "port": 8093,
      "commonsConfigurationPath": "mpl-test-server/commons-configuration.json",
      "libraryRepository": {
        "name": "aws-crypto-tools-rust",
        "url": "git@github.com:aws/aws-crypto-tools-rust.git",
        "branch": "aws-crypto-rust/mpl-test-server",
        "path": "mpl"
      },
      "serverLocation": {
        "repository": "aws-crypto-tools-rust",
        "url": "git@github.com:aws/aws-crypto-tools-rust.git",
        "ref": "aws-crypto-rust/mpl-test-server",
        "path": "mpl-test-server"
      }
    }
  ]
}
